{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-undef": "error",
    "no-constant-condition": "warn",
    "no-duplicate-case": "error",
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-extra-semi": "warn",
    "no-redeclare": "error",
    "no-unreachable": "error",
    "valid-typeof": "error",
    "no-prototype-builtins": "off",
    "no-var": "off"
  }
}
